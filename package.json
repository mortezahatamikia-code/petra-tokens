{
  "name": "@petra-base/tokens",
  "version": "0.0.6",
  "type": "module",
  "exports": {
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/generate-tokens.mjs",
    "generate:watch": "node --watch scripts/generate-tokens.mjs",
    "prebuild": "npm run generate",
    "build": "npm run generate && vite build",
    "test:snapshot": "node scripts/generate-tokens.mjs && git diff --exit-code generated/",
    "test:update-snap": "node scripts/generate-tokens.mjs && git add generated/"
  },
  "devDependencies": {
    "vite": "^6.0.3",
    "glob": "^13.0.0",
    "postcss": "^8.4.49",
    "cssnano": "^7.0.6",
    "sass": "^1.83.0"
  }
}
